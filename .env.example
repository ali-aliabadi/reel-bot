# Copy to .env for `make run`. Never commit .env. All values below are placeholders.

# Relay (skills/relay-notify): angle approvals, the morning report and failure alerts.
# The key comes from `relay clients create reel-bot` on the VPS.
RELAY_URL=https://relay.alialiabadi.ir
RELAY_APP=reel-bot
# RELAY_USER=admin

# Secret: fill in .env only.
RELAY_API_KEY=

# Claude writes the scripts (reel-bot script). Secret: fill in .env only.
# Set a monthly spend limit on the key in the Claude Console.
ANTHROPIC_API_KEY=

# OpenAI: caption word timings (reel-bot captions), later the pictures.
# Secret: fill in .env only. Set a monthly limit on the key in the OpenAI dashboard.
OPENAI_API_KEY=
