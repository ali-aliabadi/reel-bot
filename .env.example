# Copy to .env for `make run`. Never commit .env. All values below are placeholders.

# Relay (skills/relay-notify): the daily story pick, Tara's take, the finished video and failure alerts.
# The key comes from `relay clients create reel-bot` on the VPS.
RELAY_URL=https://relay.alialiabadi.ir
# On the VPS, use Relay's loopback port so the finished videos skip nginx's 8 MB limit:
# RELAY_URL=http://127.0.0.1:18080
RELAY_APP=reel-bot
# RELAY_USER=admin
# Relay username of the narrator: gets the script and the finished video (reel-bot daily).
REEL_BOT_NARRATOR=

# Secret: fill in .env only.
RELAY_API_KEY=

# Claude writes the scripts (reel-bot script). Secret: fill in .env only.
# Set a monthly spend limit on the key in the Claude Console.
ANTHROPIC_API_KEY=

# Most the paid APIs may cost per calendar month (UTC), in US dollars. Default 20.
# REEL_BOT_MONTHLY_CAP_USD=20

# Posting (reel-bot auth <platform> once, then reel-bot publish VIDEO_ID). The sign-ins are
# saved in data/tokens.json (owner-only), never in .env or git.
# YouTube: a Google Cloud OAuth client of type "Desktop app". Secret: fill in .env only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# public, unlisted or private. Until Google audits the project, YouTube locks API uploads as private.
# YOUTUBE_PRIVACY=public

# TikTok: an app at developers.tiktok.com with Login Kit and the Content Posting API (Direct Post).
# Secret: fill in .env only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# The https redirect URI registered on the app; the page itself need not exist.
TIKTOK_REDIRECT_URI=
# SELF_ONLY until TikTok audits the app, then PUBLIC_TO_EVERYONE.
# TIKTOK_PRIVACY=SELF_ONLY
